{
  "name": "WebAuditors",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm install && npm install -g @opencode/cli",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "WebAuditors dev server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["bradlc.vscode-tailwindcss"]
    }
  }
}
